APP_NAME=Mooda
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Dev: 127.0.0.1:8080 | Produksi: https://api.mooda.id
APP_URL=http://127.0.0.1:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# =====================================================================
# DATABASE
# ---------------------------------------------------------------------
# DEV  : sqlite (mandiri, seeder akun demo owner@mooda.test / password)
# PROD : SAMA dengan stakko-pos (satu DB dipakai web + API).
#        Cukup arahkan ke PostgreSQL yang sama; JANGAN jalankan migrate
#        bawaan (tabel users/dll sudah ada) — hanya `personal_access_tokens`
#        (Sanctum) yang perlu ditambahkan ke DB bersama.
# =====================================================================
DB_CONNECTION=sqlite
# --- Produksi (contoh) ---
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=stakko_pos
# DB_USERNAME=stakko
# DB_PASSWORD=

# Redis (produksi: session/cache/queue seperti stakko-pos)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# Produksi: CACHE_STORE=redis, SESSION_DRIVER=redis, QUEUE_CONNECTION=redis

# =====================================================================
# OCTANE (produksi: RoadRunner, seperti stakko-pos)
#   composer require laravel/octane (sudah)
#   php artisan octane:install --server=roadrunner   # unduh binari RR
#   php artisan octane:start --host=127.0.0.1 --port=8080
#   WAJIB: php artisan octane:reload setiap deploy.
# =====================================================================
OCTANE_SERVER=roadrunner

# =====================================================================
# SWAGGER (l5-swagger) — dokumentasi di /api/documentation
#   Produksi: set false lalu jalankan `php artisan l5-swagger:generate` saat deploy.
# =====================================================================
L5_SWAGGER_GENERATE_ALWAYS=true
# L5_SWAGGER_CONST_HOST=https://api.mooda.id

# =====================================================================
# SANCTUM — token mobile (stateful hanya bila pakai cookie; mobile pakai Bearer)
# =====================================================================
# SANCTUM_STATEFUL_DOMAINS=api.mooda.id

# CORS: origin web debug (kosong = izinkan semua utk dev; batasi di prod)
CORS_ALLOWED_ORIGINS=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@mooda.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
